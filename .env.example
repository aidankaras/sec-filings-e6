# Copy to .env and fill in. Never commit .env.

# --- Required identification for SEC EDGAR ---
# SEC requires a descriptive User-Agent with contact information on every request.
# Requests without one are rate-limited or blocked.
# Exactly two whitespace-separated parts: an identifier, then a contact email.
# A multi-word name is rejected at startup, so use a hyphenated identifier.
SEC_USER_AGENT="your-project-name your-email@example.com"

# --- Database ---
# The docker-compose Postgres service. The agent commands accept only the local
# ledger that `arbiter ledger-up` starts; set this to the URL it prints.
DATABASE_URL="postgresql+psycopg://arbiter:arbiter@localhost:5432/arbiter"

# --- Model providers ---
# Not used: the agent arm runs through a Claude Code login (`claude -p`), not
# an API key. Reserved for API-based extraction, which is not built.
ANTHROPIC_API_KEY=""
# Not yet used: the planned arbiter arm uses a different model family to
# decorrelate judge errors.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# --- Broker (paper trading only) ---
ALPACA_API_KEY=""
ALPACA_SECRET_KEY=""
ALPACA_BASE_URL="https://paper-api.alpaca.markets"

# --- Spend controls ---
# Hard ceilings enforced in code. The pipeline halts when either is crossed.
DAILY_SPEND_CEILING_USD="4.00"
PER_RUN_TOKEN_CEILING="250000"

# --- Runtime ---
ENVIRONMENT="development"
LOG_LEVEL="INFO"
